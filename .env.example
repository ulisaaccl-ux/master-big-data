# ==============================================================================
# Variables de Entorno - Pipeline ETL Big Data (Open-Meteo -> Supabase)
# Copia este archivo como .env.local y completa los valores reales
# ==============================================================================

# URL de tu proyecto en Supabase (ejemplo: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública / anon para operaciones de lectura en cliente
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_anonima_o_publica

# Clave secreta con rol de servicio (SERVICE_ROLE) para inserciones seguras desde el servidor Next.js
# IMPORTANTE: NUNCA uses el prefijo NEXT_PUBLIC_ para esta clave ni la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key_aqui
